#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# =============================================================================
#  pi-server — gestion manuelle (via SSH) du socle et des modules
#
#  sudo pi-server status            versions, modules, mises à jour, pare-feu
#  sudo pi-server update            git pull de pi-server ET des modules,
#                                   puis réinstallation (idempotente) de tout
#  sudo pi-server update <module>   idem pour un seul module (ex. pi-sound-server)
#  sudo pi-server add <module>      ajoute un module : sound | data | URL git
#  sudo pi-server remove <module>   retire un module de la liste (ne désinstalle rien)
#  pi-server list                   modules configurés
# =============================================================================
set -euo pipefail
CONF=/etc/pi-server/pi-server.conf
BASE_DIR=/opt/pi-server
declare -A ALIASES=(
    [sound]="https://github.com/flavi1/pi-sound-server.git"
    [data]="https://github.com/flavi1/pi-data-server.git"
)

die() { printf '\033[1;31mpi-server :\033[0m %s\n' "$*" >&2; exit 1; }
log() { printf '\033[1;34m[pi-server]\033[0m %s\n' "$*"; }
need_root() { [[ $EUID -eq 0 ]] || die "à lancer avec sudo"; }

[[ -f "$CONF" ]] || die "$CONF introuvable (pi-server n'est pas installé ?)"
# shellcheck source=/dev/null
. "$CONF"
MODULES_BRANCH="${MODULES_BRANCH:-main}"

mod_name() { local b; b="$(basename "$1")"; echo "${b%.git}"; }
mod_dir()  { echo "/opt/$(mod_name "$1")"; }
resolve()  { [[ -n "${ALIASES[$1]:-}" ]] && echo "${ALIASES[$1]}" || echo "$1"; }

# Recherche d'un module configuré par alias, nom ou URL
find_module() {
    local want; want="$(resolve "$1")"
    local m
    for m in "${MODULES[@]}"; do
        if [[ "$m" == "$want" || "$(mod_name "$m")" == "$1" || "$(mod_name "$m")" == "$(mod_name "$want")" ]]; then
            echo "$m"; return 0
        fi
    done
    return 1
}

# git pull --ff-only avec résumé des changements
pull() {   # pull DIR
    local d="$1" before after
    before="$(git -C "$d" rev-parse HEAD)"
    git -C "$d" pull --ff-only --quiet || die "git pull a échoué dans $d (modifications locales ? git -C $d status)"
    after="$(git -C "$d" rev-parse HEAD)"
    if [[ "$before" == "$after" ]]; then
        echo "   $(basename "$d") : déjà à jour ($(git -C "$d" log -1 --format='%h %cs'))"
    else
        echo "   $(basename "$d") : $(git -C "$d" rev-parse --short "$before") → $(git -C "$d" rev-parse --short "$after")"
        git -C "$d" log --format='      %h %s' "$before..$after"
    fi
}

clone_if_needed() {   # clone_if_needed URL
    local d; d="$(mod_dir "$1")"
    if [[ ! -d "$d/.git" ]]; then
        log "Clonage de $1 dans $d"
        git clone --branch "$MODULES_BRANCH" "$1" "$d"
    fi
}

install_module() {   # install_module URL [args]
    local url="$1"; shift
    local d; d="$(mod_dir "$url")"
    [[ -f "$d/install.sh" ]] || die "$d/install.sh introuvable"
    log "Installation du module $(mod_name "$url")"
    (cd "$d" && bash ./install.sh "$@")
    mkdir -p /var/lib/pi-server
    git -C "$d" rev-parse HEAD > "/var/lib/pi-server/$(mod_name "$url").version"
}

save_modules() {   # réécrit le tableau MODULES=( … ) dans le fichier de config
    local tmp; tmp="$(mktemp)"
    python3 - "$CONF" "$tmp" "$@" <<'PY'
import re, sys
src, dst, mods = sys.argv[1], sys.argv[2], sys.argv[3:]
t = open(src, encoding="utf-8").read()
block = "MODULES=(\n" + "".join('    "%s"\n' % m for m in mods) + ")"
t, n = re.subn(r"^MODULES=\((?:[^()]|\n)*?\)", block, t, count=1, flags=re.M)
if n == 0:
    t += "\n" + block + "\n"
open(dst, "w", encoding="utf-8").write(t)
PY
    install -m 644 "$tmp" "$CONF"; rm -f "$tmp"
}

cmd_list() {
    if [[ ${#MODULES[@]} -eq 0 ]]; then echo "Aucun module."; return; fi
    local m
    for m in "${MODULES[@]}"; do
        printf '  %-18s %s  %s\n' "$(mod_name "$m")" "$m" "$([[ -d "$(mod_dir "$m")/.git" ]] && echo "(cloné)" || echo "(non cloné)")"
    done
}

cmd_status() {
    echo "== pi-server =="
    printf '  %-18s %s\n' "socle" "$(git -C "$BASE_DIR" log -1 --format='%h %cs %s' 2>/dev/null || echo '?')"
    local m d
    for m in "${MODULES[@]}"; do
        d="$(mod_dir "$m")"
        printf '  %-18s %s\n' "$(mod_name "$m")" "$(git -C "$d" log -1 --format='%h %cs %s' 2>/dev/null || echo 'non installé')"
    done
    echo
    echo "== Système =="
    echo "  $(. /etc/os-release; echo "$PRETTY_NAME") — noyau $(uname -r)"
    echo "  nom : $(hostname) (ssh $(logname 2>/dev/null || echo utilisateur)@$(hostname).local) — IP : $(hostname -I | xargs)"
    local last=/var/log/unattended-upgrades/unattended-upgrades.log
    [[ -f "$last" ]] && echo "  dernière mise à jour auto : $(grep -h 'INFO' "$last" | tail -n1 | cut -c1-90)"
    [[ -f /var/run/reboot-required ]] && echo "  ** redémarrage nécessaire **"
    [[ -f /var/lib/pi-server/firstboot.failed ]] && echo "  !! premier démarrage en échec : $(cat /var/lib/pi-server/firstboot.failed)"
    echo
    echo "== Pare-feu (ports ouverts) =="
    nft list chain inet filter input 2>/dev/null | grep -E 'dport|saddr' | sed 's/^[[:space:]]*/  /' || echo "  nftables inactif"
    echo
    echo "Mise à jour manuelle : sudo pi-server update"
}

cmd_update() {
    need_root
    if [[ -n "${1:-}" ]]; then
        local m; m="$(find_module "$1")" || die "module inconnu : $1 (pi-server list)"
        log "Mise à jour de $(mod_name "$m")"
        clone_if_needed "$m"
        pull "$(mod_dir "$m")"
        install_module "$m"
        return
    fi
    log "Récupération des nouvelles versions"
    pull "$BASE_DIR"
    local m
    for m in "${MODULES[@]}"; do
        clone_if_needed "$m"
        pull "$(mod_dir "$m")"
    done
    # La nouvelle version du socle relance elle-même l'installation des modules
    exec bash "$BASE_DIR/install.sh"
}

cmd_install_modules() {
    need_root
    local m
    for m in "${MODULES[@]}"; do
        clone_if_needed "$m"
        install_module "$m" "$@"
    done
}

cmd_add() {
    need_root
    [[ -n "${1:-}" ]] || die "usage : pi-server add sound|data|<url git>"
    local url; url="$(resolve "$1")"
    if find_module "$url" >/dev/null; then
        log "$(mod_name "$url") est déjà configuré"
    else
        save_modules "${MODULES[@]}" "$url"
        log "Ajouté à $CONF : $url"
    fi
    clone_if_needed "$url"
    install_module "$url"
}

cmd_remove() {
    need_root
    [[ -n "${1:-}" ]] || die "usage : pi-server remove <module>"
    local m; m="$(find_module "$1")" || die "module inconnu : $1"
    local keep=() x
    for x in "${MODULES[@]}"; do [[ "$x" == "$m" ]] || keep+=("$x"); done
    save_modules "${keep[@]}"
    log "$(mod_name "$m") retiré de la liste. Rien n'a été désinstallé :"
    echo "   ses services restent actifs ; son dépôt reste dans $(mod_dir "$m")."
}

case "${1:-status}" in
    status) cmd_status ;;
    list) cmd_list ;;
    update) shift; cmd_update "$@" ;;
    install-modules) shift; cmd_install_modules "$@" ;;
    add) shift; cmd_add "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    -h|--help|help) sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "commande inconnue : $1 (pi-server help)" ;;
esac
